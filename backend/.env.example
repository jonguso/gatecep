PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
CORS_ORIGIN=http://localhost:3000

# REAL portfolio valuation reads the latest verified EOD snapshot from PostgreSQL.
MARKET_DATA_PROVIDER=LOCAL_EOD
MARKET_IMPORT_KEY=replace-with-a-long-random-admin-key
MARKET_EOD_UPSTREAM_PROVIDER=APIFY_NSE
MARKET_EOD_COLLECTION_HOUR=15
MARKET_EOD_COLLECTION_MINUTE=20
MARKET_EOD_MINIMUM_QUOTES=40
MARKET_EOD_SCHEDULER_CHECK_MS=900000
MARKET_EOD_COLLECTION_RETRY_MS=3600000
# MARKET_DATA_PROVIDER=VERIFIED_HTTP
# MARKET_DATA_PROVIDER_NAME=YOUR_LICENSED_NSE_VENDOR
# MARKET_DATA_URL=https://vendor.example/v1/nse/quotes
# MARKET_DATA_API_KEY=
# MARKET_DATA_API_KEY_HEADER=Authorization
# MARKET_DATA_API_KEY_PREFIX=Bearer 
# MARKET_DATA_MAX_AGE_MINUTES=30
# MARKET_DATA_TIMEOUT_MS=12000

# Apify is the once-daily verified EOD collector. The API token stays on the backend only.
# APIFY_ACTOR_ID=mansalabs/african-stock-market-data
# APIFY_API_TOKEN=
# APIFY_ACTOR_INPUT_JSON={"dataset":"stocks","exchangeCode":"NSE"}
# MARKET_DATA_CLOSED_MAX_AGE_MINUTES=5760
# APIFY_RUN_TIMEOUT_SECONDS=180
# APIFY_MAX_ITEMS=500
# APIFY_MAX_TOTAL_CHARGE_USD=0.25
# MARKET_CACHE_REFRESH_MS=300000

# Verified news ingestion via apify/rag-web-browser. Uses the backend APIFY_API_TOKEN above.
NEWS_COLLECTION_ENABLED=false
APIFY_NEWS_ACTOR_ID=apify/rag-web-browser
NEWS_COLLECTION_INTERVAL_MS=21600000
NEWS_LOOKBACK_DAYS=7
APIFY_NEWS_MAX_RESULTS=8
APIFY_NEWS_TIMEOUT_SECONDS=90
APIFY_NEWS_MAX_TOTAL_CHARGE_USD=0.10

# Backend-only speech transcription. Never expose this value in Expo variables.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
COACH_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
