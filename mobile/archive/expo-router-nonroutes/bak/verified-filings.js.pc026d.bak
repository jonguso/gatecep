      }
    },

    company: {
      symbol:
        "SCOM",

      name:
        "Safaricom PLC",

      sector:
        "Telecommunication and Technology",

      exchange:
        "NSE",

      currency:
        "KES",

      currentPrice:
        null,

      priceUpdatedAt:
        null,

      sharesOutstanding:
        null,

      periods: [
        {
          fiscalYear:
            null,

          periodType:
            "ANNUAL",

