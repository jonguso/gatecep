function FilingFinancials({
  filing
}) {
  const company =
    filing?.company ||
    {};

  const periods =
    safeArray(
      company?.periods
    );

  return (
    <>
      <View
        style={
          styles.summaryCard
        }
      >
        <Row
          label="Current Price"
          value={
            nullableCurrency(
              company
                ?.currentPrice
            )
          }
        />

        <Row
          label="Shares Outstanding"
          value={
            nullableNumberText(
              company
                ?.sharesOutstanding
            )
          }
        />

        <Row
          label="Financial Periods"
          value={
            periods.length
          }
        />
      </View>

      {periods.length ? (
        periods.map(
          (
            period,
            index
          ) => (
            <View
              key={
                `${period?.fiscalYear || "YEAR"}-${index}`
              }
              style={
                styles.messageCard
              }
            >
              <Text
                style={
                  styles.cardTitle
                }
              >
                FY{" "}
                {
                  period?.fiscalYear ??
                  "Unknown"
                }
              </Text>

              <Row
                label="Revenue"
                value={
                  nullableCurrency(
                    period?.revenue
                  )
                }
              />

              <Row
                label="Net Income"
                value={
                  nullableCurrency(
                    period
                      ?.netIncome
                  )
                }
              />

              <Row
                label="Free Cash Flow"
                value={
                  nullableCurrency(
                    period
                      ?.freeCashFlow
                  )
                }
              />

              <Row
                label="EPS"
                value={
                  nullableNumberText(
                    period
                      ?.earningsPerShare
                  )
                }
              />

              <Row
                label="Book Value / Share"
                value={
                  nullableNumberText(
                    period
                      ?.bookValuePerShare
                  )
                }
              />

              <Row
                label="Dividend / Share"
                value={
                  nullableNumberText(
                    period
                      ?.dividendPerShare
                  )
                }
              />
            </View>
          )
        )
      ) : (
        <EmptyState
          title="No Financial Periods"
          message="The filing does not contain normalized financial periods."
        />
      )}
    </>
  );
}

