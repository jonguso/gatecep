function FilingAudit({
  filing
}) {
  const events =
    safeArray(
      filing?.auditTrail
    )
      .slice()
      .reverse();

  return events.length ? (
    events.map(
      (
        event,
        index
      ) => (
        <View
          key={
            event?.id ||
            `AUDIT-${index}`
          }
          style={
            styles.messageCard
          }
        >
          <Text
            style={
              styles.cardTitle
            }
          >
            {formatLabel(
              event?.action
            )}
          </Text>

          <Text
            style={
              styles.cardText
            }
          >
            {
              event?.note ||
              "No audit note."
            }
          </Text>

          <Text
            style={
              styles.issueMeta
            }
          >
            {
              event
                ?.actor
                ?.name ||
              "System"
            }{" "}
            ·{" "}
            {shortDateTime(
              event?.timestamp
            )}
          </Text>
        </View>
      )
    )
  ) : (
    <EmptyState
      title="No Audit Events"
      message="No audit events are recorded for this filing."
    />
  );
}

