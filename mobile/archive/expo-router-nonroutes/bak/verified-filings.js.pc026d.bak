      }
    >
      {values.map(
        (value) => (
          <Pressable
            key={
              value
            }
            style={[
              styles.optionButton,

              selected ===
                value &&
                styles.optionButtonActive
            ]}
            onPress={() =>
              onSelect(
                value
              )
            }
          >
            <Text
              style={[
                styles.optionText,

                selected ===
                  value &&
                  styles.optionTextActive
              ]}
            >
              {formatLabel(
                value
              )}
            </Text>
          </Pressable>
        )
      )}
    </ScrollView>
  );
}

