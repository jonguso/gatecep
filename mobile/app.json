{
  "expo": {
    "name": "GateCEP",
    "slug": "gatecep",
    "version": "5.0.0",
    "scheme": "gatecep",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gatecep.mobile"
    },
    "android": {
      "package": "com.gatecep.mobile",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
