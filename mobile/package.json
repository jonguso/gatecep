{
  "name": "gatecep-mobile-coachg",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "release:check": "node scripts/check-production-readiness.mjs",
    "release:preview-preflight": "node scripts/check-android-preview-build.mjs",
    "release:audit": "npm audit --omit=dev",
    "eas:login": "npx eas-cli@23.2.0 login",
    "eas:init": "npx eas-cli@23.2.0 init",
    "eas:device:register:ios": "npx eas-cli@23.2.0 device:create",
    "build:preview:android": "npx eas-cli@23.2.0 build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli@23.2.0 build --platform ios --profile preview",
    "build:testflight:ios": "npx eas-cli@23.2.0 build --platform ios --profile production",
    "submit:testflight:ios": "npx eas-cli@23.2.0 submit --platform ios --profile production --latest",
    "release:ios-preflight": "node scripts/check-ios-testflight-build.mjs",
    "build:production": "npx eas-cli@23.2.0 build --platform all --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "axios": "~1.20.0",
    "babel-preset-expo": "~54.0.12",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.5.1",
    "serve": "^14.2.6",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "expo-doctor": "^1.19.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
