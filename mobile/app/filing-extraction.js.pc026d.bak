      marginTop:
        7
    },

    financialCard: {
      backgroundColor:
        "#020617",

      borderColor:
        "#1e293b",

      borderWidth:
        1,

      borderRadius:
        14,

      padding:
        14,

      marginTop:
        12
    },

    cardTitle: {
      color:
        "#67e8f9",

      fontWeight:
        "900"
    },

    cardText: {
