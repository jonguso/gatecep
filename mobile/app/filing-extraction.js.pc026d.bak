      borderWidth:
        1,

      borderRadius:
        11,

      padding:
        11,

      color:
        "white"
    },

    referenceInputWide: {
      flex:
        1,

      backgroundColor:
        "#0f172a",

      borderColor:
        "#334155",

      borderWidth:
        1,

      borderRadius:
        11,

      padding:
        11,

      color:
        "white"
    },

    inlineButtons: {
      flexDirection:
        "row",

      flexWrap:
        "wrap",

      gap:
        10,

