import React,{useMemo,useState} from "react";
import {Pressable,ScrollView,StyleSheet,Text,View} from "react-native";
import {router,useLocalSearchParams} from "expo-router";
import {buildPreserveGoalRecoveryQuestion,calculatePreserveGoalFundingNeed} from "../src/features/wealth-journey/preserveGoalRecoveryService";
import {startDecisionConversation} from "../src/features/trading/coachGDecisionConversationSession";
import {requestFloatingCoachGOpen} from "../src/features/trading/floatingCoachGActivationService";
function first(params,names=[]){for(const name of names){const value=params?.[name];if(value!==undefined&&value!==null&&String(value).trim()!=="")return Array.isArray(value)?value[0]:value;}return null;}
function num(value){if(value===null||value===undefined||value==="")return null;const parsed=Number(value);return Number.isFinite(parsed)?parsed:null;}
function money(value){const parsed=num(value);if(parsed===null)return "N/A";return `KES ${parsed.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`;}
export default function GoalRecoveryChoice(){const params=useLocalSearchParams();const[showFallbacks,setShowFallbacks]=useState(false);const goalName=first(params,["goalName","name","goal"])||"Financial Goal";const targetAmount=num(first(params,["targetAmount","goalTarget","targetValue"]));const targetDate=first(params,["targetDate","goalTargetDate","date"]);const monthlyContribution=num(first(params,["monthlyContribution","contribution","monthly","simulatedMonthlyContribution"]));const annualReturnPercentage=num(first(params,["annualReturnPercentage","annualReturn","expectedAnnualReturn","returnPercentage"]))??8;const projectedValue=num(first(params,["projectedValue","goalProjectedValue"]));let projectedShortfall=num(first(params,["goalShortfall","shortfall","projectedShortfall","goalGap","gap"]));if(!(Math.abs(projectedShortfall||0)>0)&&targetAmount!==null&&projectedValue!==null)projectedShortfall=Math.max(targetAmount-projectedValue,0);const fundingNeed=useMemo(()=>calculatePreserveGoalFundingNeed({projectedShortfall,targetDate,annualReturnPercentage}),[projectedShortfall,targetDate,annualReturnPercentage]);const question=useMemo(()=>buildPreserveGoalRecoveryQuestion({goalName,targetAmount,targetDate,monthlyContribution,fundingNeed}),[goalName,targetAmount,targetDate,monthlyContribution,fundingNeed]);function discussAllocationWithCoachG(){const amount=fundingNeed?.requiredNow;const scenario={source:"COACH_G_RECOVERY",action:"EXPLORE",security:null,amount,quantity:null,price:null,investorReason:`Preserve ${goalName} without changing the target date or monthly contribution.`,decisionPriority:"GOAL_RECOVERY",goalContext:{goalName,targetAmount,targetDate,monthlyContribution,futureShortfall:fundingNeed?.futureShortfall??null,additionalAmountNow:amount,preserveGoal:true,preserveTargetDate:true,preserveContribution:true},recommendationContext:{requestedAnalysis:"Review the investor's REAL holdings and diversification evidence and recommend how the additional amount could be allocated. Do not invent securities, target weights, expected returns, or trades."}};const openingText=`You chose to test adding ${money(amount)} now so that ${goalName}, the target date${targetDate?` (${targetDate})`:""}, and the current monthly contribution can remain unchanged under the current planning assumptions. I will use your REAL portfolio and available diversification evidence before suggesting where this new money could go.`;const openingQuestion="Before I compare possible additions, is there any holding or sector you do not want to add to?";startDecisionConversation({scenario,openingText,openingQuestion});requestFloatingCoachGOpen({source:"PRESERVE_GOAL_RECOVERY",question:openingQuestion,context:scenario.goalContext});}
function continueToFallbackRecovery(){router.replace({pathname:"/(tabs)/trading",params:{decisionSource:"COACH_G_RECOVERY",goalName,targetAmount:targetAmount??"",targetDate:targetDate||"",monthlyContribution:monthlyContribution??"",goalGap:fundingNeed?.futureShortfall??projectedShortfall??"",preserveGoalFundingDeclined:"true"}});}
return <ScrollView style={styles.screen} contentContainerStyle={styles.content}><Text style={styles.eyebrow}>COACH G · GOAL RECOVERY</Text><Text style={styles.title}>Keep the goal if you can</Text><Text style={styles.body}>Coach G first checks whether the current goal can be preserved before asking you to extend the timeline, increase monthly contributions, or lower the target.</Text><View style={styles.card}><Text style={styles.goal}>{goalName}</Text><View style={styles.grid}><Metric label="Target" value={money(targetAmount)}/><Metric label="Target date" value={targetDate||"N/A"}/><Metric label="Monthly contribution" value={money(monthlyContribution)}/><Metric label="Projected shortfall" value={money(fundingNeed?.futureShortfall??projectedShortfall)}/></View></View><View style={styles.primaryCard}><Text style={styles.cardEyebrow}>FIRST RECOVERY QUESTION</Text><Text style={styles.cardTitle}>{question.title}</Text><Text style={styles.body}>{question.question}</Text>{fundingNeed?.available?<><View style={styles.amountBox}><Text style={styles.amountLabel}>Estimated additional amount needed now</Text><Text style={styles.amount}>{money(fundingNeed.requiredNow)}</Text><Text style={styles.small}>This is discounted from the projected future shortfall using the same annual-return assumption shown in this scenario ({fundingNeed.annualReturnAssumption}%).</Text></View><Text style={styles.preserve}>If you choose Yes: goal target, target date, and monthly contribution stay unchanged.</Text><Pressable style={styles.primary} onPress={discussAllocationWithCoachG}><Text style={styles.primaryText}>Yes — I can add this amount</Text></Pressable><Pressable style={styles.secondary} onPress={()=>setShowFallbacks(true)}><Text style={styles.secondaryText}>No — I cannot add this amount</Text></Pressable></>:<Text style={styles.warning}>Coach G needs a valid goal shortfall and target date before calculating the amount required today.</Text>}</View>{showFallbacks?<View style={styles.card}><Text style={styles.cardEyebrow}>NEXT RECOVERY LEVEL</Text><Text style={styles.cardTitle}>Adjust the plan instead</Text><Text style={styles.body}>Since you do not want to add the full amount now, Coach G can compare extending the timeline, increasing the monthly contribution, or using a smaller combination of both. The goal target should only be reduced as a secondary alternative.</Text><Pressable style={styles.primary} onPress={continueToFallbackRecovery}><Text style={styles.primaryText}>Compare recovery alternatives</Text></Pressable></View>:null}<View style={styles.safeguard}><Text style={styles.safeguardTitle}>Simulation safeguards</Text><Text style={styles.small}>Nothing here changes your REAL portfolio, Practice portfolio, goal, contribution, Investor DNA, or places a broker order. Coach G remains advisory.</Text></View><Pressable style={styles.back} onPress={()=>router.back()}><Text style={styles.secondaryText}>Back</Text></Pressable></ScrollView>}
function Metric({label,value}){return <View style={styles.metric}><Text style={styles.metricLabel}>{label}</Text><Text style={styles.metricValue}>{value}</Text></View>}
const styles=StyleSheet.create({screen:{flex:1,backgroundColor:"#020617"},content:{padding:20,paddingBottom:80,gap:16},eyebrow:{color:"#22d3ee",fontWeight:"800",fontSize:12},title:{color:"#f8fafc",fontWeight:"900",fontSize:28},body:{color:"#cbd5e1",fontSize:15,lineHeight:22},card:{backgroundColor:"#111827",borderColor:"#334155",borderWidth:1,borderRadius:18,padding:16,gap:12},primaryCard:{backgroundColor:"#0f172a",borderColor:"#22d3ee",borderWidth:1,borderRadius:18,padding:16,gap:14},cardEyebrow:{color:"#22d3ee",fontWeight:"800",fontSize:11},cardTitle:{color:"#f8fafc",fontWeight:"900",fontSize:21},goal:{color:"#67e8f9",fontWeight:"900",fontSize:20},grid:{flexDirection:"row",flexWrap:"wrap",gap:10},metric:{minWidth:180,flexGrow:1,backgroundColor:"#020617",borderRadius:12,padding:12},metricLabel:{color:"#94a3b8",fontSize:12},metricValue:{color:"#f8fafc",fontWeight:"800",marginTop:4},amountBox:{backgroundColor:"#020617",borderRadius:14,padding:14,gap:6},amountLabel:{color:"#94a3b8",fontSize:12},amount:{color:"#86efac",fontWeight:"900",fontSize:26},small:{color:"#94a3b8",lineHeight:19},preserve:{color:"#86efac",fontWeight:"700"},warning:{color:"#fbbf24",lineHeight:20},primary:{backgroundColor:"#0891b2",borderRadius:12,paddingVertical:14,paddingHorizontal:16,alignItems:"center"},primaryText:{color:"#fff",fontWeight:"900"},secondary:{borderColor:"#22d3ee",borderWidth:1,borderRadius:12,paddingVertical:13,paddingHorizontal:16,alignItems:"center"},secondaryText:{color:"#67e8f9",fontWeight:"800"},safeguard:{backgroundColor:"#1c1917",borderColor:"#a16207",borderWidth:1,borderRadius:14,padding:14,gap:6},safeguardTitle:{color:"#fde047",fontWeight:"900"},back:{alignSelf:"flex-start",padding:10}});
